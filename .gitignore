# Local Netlify folder
.netlify
node_modules/
.env

# Vehicle images (managed externally)
assets/vehicles/

# CSV data files (imported locally, not tracked)
*.csv

# Prerendered blog posts (generated by prerender-blog.js at build time)
/blog/

# Sitemaps (generated by generate-sitemap.js at build time; Netlify rebuilds them on every deploy)
/sitemap.xml
/sitemap-main.xml

# TypeScript build output
netlify/functions/dist/
